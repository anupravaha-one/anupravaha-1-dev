/* 
 * here is where system comupted values get stored these values should only
 * change when the target compile platform changes 
 */

/* what threading system are we using */
#cmakedefine CMAKE_USE_PTHREADS
#ifdef CMAKE_USE_PTHREADS
#define APK_USE_PTHREADS
#endif

#cmakedefine CMAKE_USE_SPROC
#ifdef CMAKE_USE_SPROC
#define APK_USE_SPROC
#endif

#cmakedefine CMAKE_HP_PTHREADS
#ifdef CMAKE_HP_PTHREADS
#define APK_HP_PTHREADS
#endif

#cmakedefine CMAKE_USE_WIN32_THREADS
#ifdef CMAKE_USE_WIN32_THREADS
#define APK_USE_WIN32_THREADS
#endif

#cmakedefine APK_EXPLICIT_TEMPLATES
#ifndef APK_EXPLICIT_TEMPLATES
#define APK_NO_EXPLICIT_TEMPLATE_INSTANTIATION
#endif

#cmakedefine CMAKE_NO_ANSI_STRING_STREAM
#ifdef CMAKE_NO_ANSI_STRING_STREAM
#define APK_NO_ANSI_STRING_STREAM
#endif

#cmakedefine CMAKE_NO_STD_NAMESPACE
#ifdef CMAKE_NO_STD_NAMESPACE
#define APK_NO_STD_NAMESPACE
#endif

#cmakedefine APK_BUILD_SHARED_LIBS
#ifdef APK_BUILD_SHARED_LIBS
#define APKDLL
#else
#define APKSTATIC
#endif

#cmakedefine APK_USE_64BIT_IDS

#cmakedefine APK_USE_ANSI_STDLIB

/* compiler used */
#define APK_CXX_COMPILER "${CMAKE_CXX_COMPILER}"

#define APK_MAJOR_VERSION @APK_MAJOR_VERSION@
#define APK_MINOR_VERSION @APK_MINOR_VERSION@
#define APK_BUILD_VERSION @APK_BUILD_VERSION@
#define APK_VERSION "@APK_VERSION@"


/* Whether type "bool" is supported by the compiler.  */
#cmakedefine APK_COMPILER_HAS_BOOL
